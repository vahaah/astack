{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!upstream",
			"!!marketplace/*/pstack",
			"!!marketplace/*/flow",
			"!marketplace/plugins/astack/bin/astack.js",
			"!docs/charts/*.svg",
			"!!dist",
			"!!tests/fixtures"
		]
	}
}
