	"abstraction": {
		"hides": "The JSON form of the review record, its path in the git common dir, the temporary file of a save, and the git ancestry reads that pick the delta head.",
		"callersKnow": [
			"astack review base exits 0 with a delta: line, 3 with a full: line, 1 for an unreadable record or a branch that git cannot name, and 2 for wrong arguments.",
			"astack review record creates an absent record from the merge base and adds a head with its decision and launches. It never writes over an unreadable record.",
			"ciMode gives ok, ci_proof, ci_mixed or stop from the stop kinds, the base move, the paths outside CI, a record problem and the tool state."
		],
		"deletionTest": "Without review-record.ts, the engine and each caller parse the record JSON and pick the delta head again, and a hand-written record loses the launch count.",
		"alternatives": [
			{
				"name": "Hand-written JSON, as before",
				"rejectedBecause": "An agent can drop a field or replace the first-review fields, and no file counts the launches."
			},
			{
				"name": "One file for each reviewed head",
				"rejectedBecause": "The order of the heads then depends on file times."
			},
			{
				"name": "Advisory reds in ci_mixed, as in ci_proof",
				"rejectedBecause": "A red gate can come from a product defect."
			}
		],
