		"invariants": [
			{
				"name": "A grant covers only the PRs that merge words or a full send clause name",
				"modelRef": "GrantFromWords"
			},
			{
				"name": "Only a person's prompt sets a grant",
				"modelRef": "GrantFromPerson"
			},
			{
				"name": "A merge needs a profile grant or a covering prompt of a person",
				"modelRef": "MergeNeedsAuthority"
			},
			{
				"name": "Full stop never merges",
				"modelRef": "FullStopNeverMerges"
			},
			{
				"name": "A write outside the scratch class keeps its write checks",
				"modelRef": "WriteChecksKept"
			},
			{
				"name": "A scratch write skips the write checks",
				"modelRef": "ScratchSkipped"
			},
			{
				"name": "Each commit keeps its commit checks",
				"modelRef": "CommitSurfaceChecked"
			},
			{
				"name": "A work-loss command on the tree or a folder never passes",
				"modelRef": "BroadLossDenied"
			},
